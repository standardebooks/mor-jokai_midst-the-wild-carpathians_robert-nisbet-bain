		<dc:title id="title">’Midst the Wild Carpathians</dc:title>
		<meta property="file-as" refines="#title">’Midst the Wild Carpathians</meta>
		<meta property="dcterms:alternative" refines="#title">The Golden Age in Transylvania</meta>
		<dc:subject id="subject-1">Historical fiction</dc:subject>
		<meta property="authority" refines="#subject-1">LCSH</meta>
